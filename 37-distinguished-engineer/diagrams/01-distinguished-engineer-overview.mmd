flowchart TD
    DE[Distinguished Engineer]

    DE --> TV[Company-Wide<br/>Technical Vision]
    DE --> OT[Organizational<br/>Transformation]
    DE --> TL[External Thought<br/>Leadership]

    subgraph sg_tv [Technical Vision]
        TV --> TV1[Set 5-plus year<br/>technology direction]
        TV --> TV2[Define platform<br/>strategy across BUs]
        TV --> TV3[Champion emerging<br/>technology adoption]
        TV --> TV4[Resolve cross-org<br/>technical conflicts]
    end

    subgraph sg_ot [Organizational Transformation]
        OT --> OT1[Reshape engineering<br/>culture]
        OT --> OT2[Drive major<br/>migrations at scale]
        OT --> OT3[Build and elevate<br/>principal engineers]
        OT --> OT4[Influence hiring<br/>bar and processes]
    end

    subgraph sg_tl [Thought Leadership]
        TL --> TL1[Publish papers and<br/>conference talks]
        TL --> TL2[Represent company<br/>in industry forums]
        TL --> TL3[Contribute to<br/>open source strategy]
        TL --> TL4[Shape industry<br/>standards]
    end

    %% Styles
    style DE fill:#2d3436,color:#fff,stroke:#636e72,stroke-width:2px
    style TV fill:#0984e3,color:#fff,stroke:#74b9ff,stroke-width:2px
    style OT fill:#6c5ce7,color:#fff,stroke:#a29bfe,stroke-width:2px
    style TL fill:#e17055,color:#fff,stroke:#fab1a0,stroke-width:2px

    style TV1 fill:#dfe6e9,stroke:#0984e3
    style TV2 fill:#dfe6e9,stroke:#0984e3
    style TV3 fill:#dfe6e9,stroke:#0984e3
    style TV4 fill:#dfe6e9,stroke:#0984e3

    style OT1 fill:#dfe6e9,stroke:#6c5ce7
    style OT2 fill:#dfe6e9,stroke:#6c5ce7
    style OT3 fill:#dfe6e9,stroke:#6c5ce7
    style OT4 fill:#dfe6e9,stroke:#6c5ce7

    style TL1 fill:#dfe6e9,stroke:#e17055
    style TL2 fill:#dfe6e9,stroke:#e17055
    style TL3 fill:#dfe6e9,stroke:#e17055
    style TL4 fill:#dfe6e9,stroke:#e17055

    style sg_tv fill:none,stroke:#0984e3,stroke-width:1px,stroke-dasharray:5
    style sg_ot fill:none,stroke:#6c5ce7,stroke-width:1px,stroke-dasharray:5
    style sg_tl fill:none,stroke:#e17055,stroke-width:1px,stroke-dasharray:5
